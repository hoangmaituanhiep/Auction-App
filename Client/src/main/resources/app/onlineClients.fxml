<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="300.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.OnlineClientController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Online Clients" />
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label prefHeight="33.0" prefWidth="42.0" text="Kick:">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <TextField fx:id="kickUsername" prefHeight="31.0" prefWidth="161.0" promptText="username" />
            <Button fx:id="kick" mnemonicParsing="false" onAction="#kickUser" prefHeight="31.0" prefWidth="60.0" text="KICK" />
         </children>
      </HBox>
      <ListView fx:id="clientsListView" prefHeight="330.0" prefWidth="260.0" VBox.vgrow="ALWAYS" />
   </children>
</VBox>
