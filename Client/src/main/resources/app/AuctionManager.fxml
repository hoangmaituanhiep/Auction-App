<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.AuctionManagerController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="1280.0" spacing="20.0" style="-fx-background-color: #070707;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Auction Manager">
               <HBox.margin>
                  <Insets left="30.0" />
               </HBox.margin>
            </Label>
            <VBox HBox.hgrow="ALWAYS" />
            <Button fx:id="addNewItem" mnemonicParsing="false" onAction="#addNewItem" prefHeight="42.0" prefWidth="140.0" text="ADD ITEM">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="backToMainWeb" mnemonicParsing="false" onAction="#backToMainWeb" prefHeight="42.0" prefWidth="160.0" text="BACK TO MAIN">
               <HBox.margin>
                  <Insets right="30.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" prefHeight="620.0" prefWidth="1280.0" spacing="20.0">
         <children>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Your Items" />
            <ListView fx:id="itemListView" prefHeight="560.0" prefWidth="1180.0" />
            <Label fx:id="notiLabel" />
         </children>
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
